// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Client {
  id        Int       @id @default(autoincrement())
  name      String

  // CRM拡張フィールド
  homepageUrl     String?
  contactPerson   String?
  status          String    @default("[]")
  rank            String    @default("C")
  history         String?
  salesIdea       String?
  needs           String?
  approach        String?
  messageToClient String?
  firstContact    DateTime?
  meetingDate     DateTime?
  contractDate    DateTime?
  contactType     ContactType?
  email           String?
  notes           String?
  salesText       String?
  salesTextUpdated Boolean @default(false)
  salesTextUpdatedMonth String?
  regularContact  Boolean  @default(false)
  regularContactMonth String?
  lastContact     DateTime?

  // 契約書管理
  contractPdfPath String?
  contractPdfName String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  projects  Project[]

  @@map("clients")
}

model OutsourcingPartner {
  id        Int       @id @default(autoincrement())
  name      String
  type      PartnerType @default(DESIGNER)

  // ポートフォリオ・契約管理
  portfolioUrl    String?
  contractPdfPath String?
  contractPdfName String?
  email           String?
  notes           String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projectPartners ProjectOutsourcingPartner[]

  @@map("outsourcing_partners")
}

model Project {
  id                        Int       @id @default(autoincrement())
  name                      String
  description               String?
  clientId                  Int
  client                    Client    @relation(fields: [clientId], references: [id])

  // ステータス関連
  salesStatus               SalesStatus @default(CONSULTING)
  progressStatus            ProgressStatus @default(NOT_STARTED)

  // 日付関連
  consultationDate          DateTime?
  orderDate                 DateTime?
  startDate                 DateTime?
  firstDraftDate            DateTime?
  deliveryDate              DateTime?

  // 外注関連
  hasOutsourcing            Boolean   @default(false)
  outsourcingPartnerSheetUrl String?
  projectPartners           ProjectOutsourcingPartner[]

  // クライアント共有
  clientSheetUrl            String?

  // 請求・支払い関連
  amount                    Int       @default(0)
  outsourcingCost           Int       @default(0)
  invoiceIssued             Boolean   @default(false)
  paymentConfirmed          Boolean   @default(false)
  paymentDueDate            DateTime?

  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  tasks                     Task[]
  phases                    ProjectPhase[]

  @@map("projects")
}

enum SalesStatus {
  CONSULTING        // 相談中
  QUOTE_SUBMITTED   // お見積り提示中
  ORDER_CONFIRMED   // 受注確定
  IN_PROGRESS       // 進行中
  DELIVERED         // 納品
  WAITING_CONTACT   // 連絡待ち
  LOST              // 失注
}

enum ProgressStatus {
  NOT_STARTED       // 未着手
  DESIGNING         // デザイン中
  CODING            // コーディング中
  REVIEWING         // 確認中
  REVISING          // 修正中
  DELIVERED         // 納品済
}

enum PartnerType {
  DESIGNER          // デザイナー
  CODER             // コーダー
}

model ProjectOutsourcingPartner {
  id                    Int                 @id @default(autoincrement())
  projectId             Int
  outsourcingPartnerId  Int

  project               Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  outsourcingPartner    OutsourcingPartner  @relation(fields: [outsourcingPartnerId], references: [id], onDelete: Cascade)

  createdAt             DateTime            @default(now())

  @@unique([projectId, outsourcingPartnerId])
  @@map("project_outsourcing_partners")
}

model RegularContactTemplate {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  histories RegularContactHistory[]

  @@map("regular_contact_templates")
}

model RegularContactHistory {
  id          Int      @id @default(autoincrement())
  templateId  Int
  title       String
  content     String
  year        Int
  month       Int
  createdAt   DateTime @default(now())

  template RegularContactTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, year, month])
  @@map("regular_contact_histories")
}

model Task {
  id          Int          @id @default(autoincrement())
  title       String
  description String?
  category    TaskCategory @default(OTHER)
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(PENDING)
  projectId   Int?
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId    Int?
  parent      Task?        @relation("SubTasks", fields: [parentId], references: [id], onDelete: Cascade)
  subTasks    Task[]       @relation("SubTasks")
  completed   Boolean      @default(false)
  completedAt DateTime?
  startDate   DateTime?
  dueDate     DateTime?
  isAllDay    Boolean      @default(false)
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("tasks")
}

enum TaskCategory {
  PROJECT   // 案件
  ADMIN     // 事務
  SALES     // 営業
  OTHER     // その他
}

enum TaskPriority {
  URGENT    // 緊急
  HIGH      // 高
  MEDIUM    // 中
  LOW       // 低
}

enum TaskStatus {
  PENDING      // 未対応
  IN_PROGRESS  // 対応中
}

enum ContactType {
  EMAIL        // メール
  CHATWORK     // Chatwork
  SLACK        // Slack
  SNS          // SNS
  LINE         // LINE
  OTHER        // その他
}

model ProjectPhase {
  id              Int              @id @default(autoincrement())
  projectId       Int
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type            PhaseType        @default(DESIGN)
  name            String           // 工程名（例: デザイン、コーディング）

  // 日程管理
  startDate       DateTime?        // 着手日
  firstDraftDate  DateTime?        // 初稿日
  deliveryDate    DateTime?        // 納品日

  // 進捗管理
  status          PhaseStatus      @default(NOT_STARTED)

  // 補足情報
  notes           String?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("project_phases")
}

enum PhaseType {
  DESIGN          // デザイン
  CODING          // コーディング
  OTHER           // その他
}

enum PhaseStatus {
  NOT_STARTED     // 未着手
  IN_PROGRESS     // 進行中
  FIRST_DRAFT     // 初稿提出済み
  REVISING        // 修正中
  COMPLETED       // 完了
}

// テンプレート管理
model Template {
  id          Int      @id @default(autoincrement())
  name        String   // テンプレート名
  description String?  // 説明
  url         String?  // URL（Googleスプレッドシートなど）
  pdfPath     String?  // PDFファイルパス
  pdfName     String?  // PDFファイル名
  category    String   @default("その他") // カテゴリ（案件管理、請求書、契約書など）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("templates")
}
